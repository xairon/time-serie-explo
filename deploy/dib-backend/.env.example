# ─── Junon BACKEND (<backend-host>) — template ───
# Copier en .env et ajuster.

# GPU : cuda sur dib (RTX A6000). cpu seulement pour test local.
BACKEND=cuda

# Postgres (entrepôt de données)
POSTGRES_USER=junon
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=junon_db

# Port d'exposition de l'API sur le réseau interne universitaire.
# Le nginx du frontend (K8s) proxie /api/ vers <backend-host>:${BACKEND_PORT}.
# Ne PAS ouvrir ce port sur Internet — réseau interne uniquement.
BACKEND_PORT=49514
MLFLOW_PORT=49512

# Entrepôt BRGM (réseau docker externe hubeau_data_integration_default)
BRGM_DB_PASSWORD=

# false en production partagée (masque /docs, /redoc, /openapi.json)
DEBUG=false

# URL(S) PUBLIQUE(S) servie(s) par le front K8s, séparées par des virgules.
# Ex : https://junon.univ-tours.fr
ALLOWED_ORIGINS=https://junon.example.univ-tours.fr

# ─── Auth ───
# Secret de signature des JWT de session. OBLIGATOIRE en prod (>=32 octets).
# Générer : openssl rand -hex 32
JWT_SECRET=change_me_use_openssl_rand_hex_32
# true en production (TLS). Mettre false UNIQUEMENT si l'accès se fait en HTTP
# (sinon le navigateur rejette le cookie de session marqué Secure).
COOKIE_SECURE=true
