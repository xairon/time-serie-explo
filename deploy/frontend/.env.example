# ─── Junon FRONTEND (distant) — template ───
# Copier en .env et ajuster.

# Adresse du backend FastAPI sur <backend-host>, réseau interne universitaire.
# Soit le nom DNS, soit l'IP, suivi du port exposé par la stack backend.
DIB_BACKEND=backend-host.example.org:49514

# Port public local (ignoré sur K8s, géré par l'Ingress).
FRONT_PORT=49513
