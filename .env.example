# ─── Junon Time-Series Explorer — environment template ───
# Copy to .env and adjust for your deployment.

# Docker compose profile
# Use BACKEND=cuda for GPU, BACKEND=cpu for CPU-only, BACKEND=xpu for Intel Arc
BACKEND=cpu
COMPOSE_FILE=docker-compose.yml

# ─── Required: the stack refuses to start without these ───
# Session signing key. Generate one, never reuse the example:
#     openssl rand -hex 32
# api/config.py rejects anything shorter than 32 characters outside DEBUG.
JWT_SECRET=

# Internal Junon Postgres (datasets, training metadata)
POSTGRES_USER=junon
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=junon_db
POSTGRES_PORT=5432

# ─── Host ports (must be free on the deployment server) ───
APP_PORT=49513
MLFLOW_PORT=49512
# Backend port published for the split deployment (K8s frontend -> this host)
BACKEND_PORT=49514

# ─── BRGM data warehouse ───
# Junon READS the warehouse produced by the hubeau_data_integration project. It
# reaches it over the external docker network `hubeau_data_integration_default`,
# at host `brgm-postgres`. That network only exists once the hubeau stack has been
# started at least once — bring hubeau up before Junon, or Junon will fail with
# "network hubeau_data_integration_default declared as external, but could not be found".
# Set this to the **PG_PASSWORD of the hubeau stack** — Junon connects to hubeau's
# PostgreSQL as user `postgres`, so the two values must match. Leaving it empty does not
# disable the Observatory gracefully: its endpoints answer HTTP 500 with
# `fe_sendauth: no password supplied`.
BRGM_DB_PASSWORD=

# ─── Runtime ───
# DEBUG=true exposes /docs, /redoc, /openapi.json — leave false for shared deployments.
DEBUG=false
# Comma-separated list of allowed CORS origins. Must include the public URL
# users will hit (e.g. http://server.intranet:49513 for remote deploys).
ALLOWED_ORIGINS=http://localhost:49513
# Session cookie `Secure` flag. Keep true wherever the app is served over HTTPS.
# Browsers treat http://localhost as a secure context, so true works for a local
# install too — but over plain HTTP on a LAN IP or hostname the browser silently
# drops the session cookie and login appears to fail. Set false only for such a
# non-TLS deployment, and understand what you are giving up.
COOKIE_SECURE=true

# ─── Dev stack only (docker-compose.dev.yml) ───
# BACKEND_PORT_DEV=49516
# MLFLOW_PORT_DEV=49517
# FRONTEND_PORT_DEV=49518
# ALLOWED_ORIGINS_DEV=http://localhost:49518
